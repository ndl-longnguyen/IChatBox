DEBUG=True
SECRET_KEY=change-me

# Optional (docker-compose sets these for you)
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=ichatbox
POSTGRES_USER=ichatbox
POSTGRES_PASSWORD=ichatbox

# Local AI (Ollama)
AI_LOCAL_BASE_URL=http://ollama:11434
AI_LOCAL_MODEL=llama3.2:3b
AI_LOCAL_TIMEOUT_SECONDS=60
AI_LOCAL_MAX_TOKENS=220
AI_LOCAL_NUM_CTX=4096
AI_KNOWLEDGE_CHUNK_SIZE=1200
AI_KNOWLEDGE_CHUNK_OVERLAP=160
AI_KNOWLEDGE_UPLOAD_MAX_BYTES=2097152
